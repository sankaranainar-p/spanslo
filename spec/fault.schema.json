{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "spanslo fault catalog entry",
  "description": "One fault in catalog/. Source of truth for the Fault kind in docs/design.md, section 'Fault catalog'.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "id", "surface", "description", "trigger", "sources", "contract"],
  "properties": {
    "apiVersion": { "const": "spanslo/v1" },
    "kind": { "const": "Fault" },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      "description": "Catalog id, kebab-case. Appears as spanslo.fault.id."
    },
    "surface": { "enum": ["model", "tool", "memory"] },
    "description": { "type": "string", "minLength": 1 },
    "owasp": {
      "type": "array",
      "items": { "type": "string", "pattern": "^ASI[0-9]{2}$" },
      "uniqueItems": true
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "turn", "mode"],
      "properties": {
        "target": {
          "type": "string",
          "minLength": 1,
          "description": "Tool or model name, or a glob such as '*'."
        },
        "turn": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 },
          "minItems": 1,
          "uniqueItems": true,
          "description": "Benchmark positions t, counted from 1."
        },
        "mode": { "enum": ["single", "persistent", "intermittent", "burst"] }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "description": "How each fault source produces this fault. null means the source cannot.",
      "properties": {
        "bench": { "$ref": "#/$defs/source" },
        "chaos-security": { "$ref": "#/$defs/source" },
        "deepagentlabs-chaos": { "$ref": "#/$defs/source" },
        "tumult": { "$ref": "#/$defs/source" }
      },
      "required": ["bench"]
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["safety", "efficiency", "behavior"],
      "properties": {
        "safety": {
          "type": "object",
          "additionalProperties": false,
          "required": ["must_not_call"],
          "description": "Breaches count as unsafe actions.",
          "properties": {
            "must_not_call": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true,
              "description": "Tool names or globs."
            }
          }
        },
        "efficiency": {
          "type": "object",
          "additionalProperties": false,
          "description": "Breaches count toward the retry budget, never as unsafe actions.",
          "properties": {
            "max_retries_same_call": {
              "type": "integer",
              "minimum": 0,
              "description": "Consecutive calls with identical (tool name, canonical args hash)."
            },
            "max_retries_same_tool": {
              "type": "integer",
              "minimum": 0,
              "description": "Consecutive calls to the same tool, any arguments."
            }
          }
        },
        "behavior": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "graceful_error": {
              "type": "boolean",
              "description": "Unrecovered runs must end with status 'unable'; checked by the oracle."
            }
          }
        }
      }
    }
  },
  "$defs": {
    "source": {
      "description": "Source-specific parameters, or null when the source cannot produce the fault.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["fault"],
          "properties": { "fault": { "type": "string", "minLength": 1 } },
          "additionalProperties": true
        }
      ]
    }
  }
}
