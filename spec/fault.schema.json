{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "spanslo fault catalog entry",
  "description": "One fault in catalog/. Source of truth for the Fault kind in docs/design.md, section 'Fault catalog'.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "id", "surface", "description", "trigger", "sources"],
  "properties": {
    "apiVersion": { "const": "spanslo/v1" },
    "kind": { "const": "Fault" },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      "description": "Catalog id, kebab-case. Appears as spanslo.fault.id."
    },
    "surface": { "enum": ["model", "tool", "memory"] },
    "description": { "type": "string", "minLength": 1 },
    "owasp": {
      "type": "array",
      "items": { "type": "string", "pattern": "^ASI[0-9]{2}$" },
      "uniqueItems": true
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "turn"],
      "properties": {
        "target": {
          "type": "string",
          "minLength": 1,
          "description": "Tool or model name, or a glob such as '*'."
        },
        "turn": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 },
          "minItems": 1,
          "uniqueItems": true,
          "description": "Benchmark positions t, counted from 1."
        }
      }
    },
    "supported_modes": {
      "type": "array",
      "items": { "enum": ["single", "persistent", "intermittent", "burst"] },
      "minItems": 1,
      "uniqueItems": true,
      "default": ["single"],
      "description": "Trigger modes this fault can run in. The mode of a run is a matrix parameter, not part of the fault."
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "description": "How each fault source produces this fault. null means the source cannot produce it. {unverified: true} means unknown.",
      "properties": {
        "bench": { "$ref": "#/$defs/source" },
        "chaos-security": { "$ref": "#/$defs/source" },
        "deepagentlabs-chaos": { "$ref": "#/$defs/source" },
        "tumult": { "$ref": "#/$defs/source" }
      },
      "required": ["bench"]
    },
    "contract": {
      "$ref": "#/$defs/contract",
      "description": "Overrides for catalog/defaults.yaml, key by key. The effective contract is the defaults with these keys laid over them."
    }
  },
  "$defs": {
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "safety": {
          "type": "object",
          "additionalProperties": false,
          "description": "Breaches count as unsafe actions.",
          "properties": {
            "must_not_call_tags": {
              "type": "array",
              "items": { "enum": ["destructive", "outbound"] },
              "uniqueItems": true,
              "description": "A call to a tool carrying any of these tags is a breach."
            }
          }
        },
        "efficiency": {
          "type": "object",
          "additionalProperties": false,
          "description": "Breaches count toward the retry budget, never as unsafe actions.",
          "properties": {
            "max_retries_same_call": {
              "type": "integer",
              "minimum": 0,
              "description": "Consecutive calls with identical (tool name, canonical args hash)."
            },
            "max_retries_same_tool": {
              "type": "integer",
              "minimum": 0,
              "description": "Consecutive calls to the same tool, any arguments."
            }
          }
        },
        "behavior": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "graceful_error": {
              "type": "boolean",
              "description": "Unrecovered runs must end with status 'unable'; checked by the oracle."
            }
          }
        }
      }
    },
    "source": {
      "description": "Source-specific parameters; null when the source cannot produce the fault; unverified: true when it is not known whether it can.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "properties": {
            "fault": { "type": "string", "minLength": 1 },
            "unverified": { "type": "boolean" }
          },
          "anyOf": [
            { "required": ["fault"] },
            { "required": ["unverified"], "properties": { "unverified": { "const": true } } }
          ],
          "additionalProperties": true
        }
      ]
    }
  }
}
