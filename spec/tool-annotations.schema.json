{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "spanslo bench tool manifest",
  "description": "tools.json of a server in bench/tools. Every tool sets all four MCP annotation hints explicitly, so bench tools are never untagged. See tool_tags and bench_tools_must_set in spec/semconv-mapping.yaml.",
  "type": "object",
  "additionalProperties": false,
  "required": ["tools"],
  "properties": {
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "annotations"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "annotations": {
            "type": "object",
            "additionalProperties": false,
            "required": ["readOnlyHint", "destructiveHint", "idempotentHint", "openWorldHint"],
            "properties": {
              "title": { "type": "string" },
              "readOnlyHint": { "type": "boolean" },
              "destructiveHint": { "type": "boolean" },
              "idempotentHint": { "type": "boolean" },
              "openWorldHint": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
